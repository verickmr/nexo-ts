DATABASE_URL=postgresql://nexo:nexo_local@localhost:55435/nexo
DIRECT_URL=postgresql://nexo:nexo_local@localhost:55435/nexo
DB_PORT=55435
APP_URL=http://localhost:3000
AUTH_MODE=demo
# groq = IA real; scripted = somente demonstração/testes, identificados na interface.
AI_MODE=groq
GROQ_API_KEY=
LLM_MODEL=groq/openai/gpt-oss-120b
MAX_DAILY_AI_CALLS=200
MAX_DAILY_AI_TOKENS=150000
MAX_MESSAGES_PER_MINUTE=6
LEGACY_FAILURE_RATE=0
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nexo Assist <assist@nexo.example>
# Necessária para o seed no modo password (mínimo de 12 caracteres).
SEED_PASSWORD=
